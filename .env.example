DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=troque-esta-chave-em-producao
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://risco:risco@db:5432/risco
REDIS_URL=redis://redis:6379/0

# Armazenamento de arquivos (compatível com S3) — vazio usa disco local em dev
S3_ENDPOINT=
S3_BUCKET=
S3_KEY=
S3_SECRET=

# Assinatura: simple (R1) | qualified (R2, ICP-Brasil)
SIGNING_MODE=simple
SIGNING_PROVIDER=cloud_a3
ICP_CERT_REF=
TIMESTAMP_AUTHORITY_URL=
PUBLIC_VERIFY_BASE_URL=http://localhost:8000
